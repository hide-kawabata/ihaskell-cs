{
  "name": "IHaskell Codespaces",
  "image": "ghcr.io/ihaskell/ihaskell-notebook:master",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "haskell.haskell"
      ]
    }
  },
  "postCreateCommand": "mkdir -p ~/.ihaskell && ln -sf $(pwd)/.devcontainer/rc.hs ~/.ihaskell/rc.hs"
}